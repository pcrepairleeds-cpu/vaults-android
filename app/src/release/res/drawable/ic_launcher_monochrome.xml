<!-- QLine Vaults themed-icon layer: the same "V" as the foreground, flat colour.
     Android 13+ tints and draws THIS layer when themed icons are enabled, so it
     must match ic_launcher_foreground or the icon changes shape when the user
     toggles a system setting.

     Exists in main/, release/ and beta/ - keep all three identical. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M32,34 L40,34 L54,68 L68,34 L76,34 L58,76 L50,76 Z" />
</vector>
